/// Shared types for work machines and the entity-owner machines that call them.
/// Replaces the `autoflow_outcome_v1` and `workflow_dispatch_v1` JSON contracts.

/// What a work machine tells its owner to do next.
enum OutcomeStatus { complete, retry, await_external, dispatch, blocked, ongoing }   // `ongoing` was "continue"

/// Hand the entity to another machine.
type Dispatch {
  workflow: string
  inputs:   json
}

/// The outcome every work machine returns to its owner.
type Outcome {
  status:       OutcomeStatus
  summary:      string
  retry_after?: duration
  pr_url?:      string
  reason?:      string
  dispatch?:    Dispatch
  artifacts?:   list<string>
}
