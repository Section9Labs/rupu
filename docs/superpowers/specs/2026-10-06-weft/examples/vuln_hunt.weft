// An agentiflow as a weft machine. The fixed Rust envelope loop becomes a
// `pursue` block; the AgentiflowDef fields become agentic top-level blocks.

/// Lead-driven fleet hunt for exploitable memory-safety bugs.
machine vuln_hunt
version "1"
uses agentic

input {
  /// Path of the repository to hunt in.
  target: string
}

output hunt : PursueResult

engagement_profiles [binary]

scope {
  authorized true
  roots      [{ kind: "repo", path: target }]
}

pool {
  agents    [@hunt-lead, @fuzzer, @reverser, @verifier]
  workflows all
}

goals {
  goal memory_bugs {
    objective    "Find exploitable memory-safety bugs."
    findings     classification "memory-safety", count >= 3
    verified     with_poc
    verify_with  @verifier
    required     true
  }
}

limits { wall_clock 6h }

flow {
  hunt = pursue goals [memory_bugs, coverage(reach: 0.9)] (budget: { usd: 50, tokens: 5_000_000 },
                                                            max_rounds: 40, max_errors: 5) {
    round {
      agent @hunt-lead (tools: [fleet.*, catalog.*, goal.status, coverage.status, budget.status, report_finding],
                        max_turns: 50) """
        Round {{ round }}.
        Goals: {{ goals.summary }}
        Coverage: {{ coverage.summary }}
        {% if steering.size() > 0 %}Operator says:
        {{ steering | join("\n") }}{% end %}
      """
    }
    on round(10) {
      approve "10 rounds in: {{ goals.summary }}. Keep hunting?"
        after 2h { yield null }                       // nobody answered → carry on
    }
    on stalled(3) {
      note "no goal progress in 3 rounds"
      steering = steering + ["Change strategy: try a different attack surface."]
    }
    on soft_budget { note "80% of budget spent; converging" }
    finally {
      agent @hunt-lead (max_turns: 10) "Wind down: record every unbanked finding now."
    }
  }
}

test "stops when goals are met" {
  given input { target: "/src/widget" }
  mock agent @hunt-lead     returns "round done"
  mock assess *             returns sequence [
    { goals_met: false, coverage_reached: false, stage: "ok" },
    { goals_met: true,  coverage_reached: false, stage: "ok" } ]
  expect end completed
  expect hunt.reason.kind == goals_met
  expect hunt.rounds == 1
}
