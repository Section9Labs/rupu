/// Rebase, wait for CI and review in parallel, and merge a PR; recover from
/// conflicts; pause and resume exactly where it was.
machine pr_shepherd
version "1"
uses agentic

input {
  repo: string
  pr:   int
}

event repair { reason: string }
event hold                                   // domain-level hold (engine pause is separate, §8.6)
event unhold

instance keyed "{{ repo }}#{{ pr }}" {
  route github.check.completed by "{{ event.repo.full_name }}#{{ event.pr.number }}"
  route github.pr.*            by "{{ event.repo.full_name }}#{{ event.pr.number }}"
  inbox queue
}

var attempts   = 0
var last_error : Error? = null

on github.pr.closed if event.pr.number == pr -> abandoned
on hold                                      -> paused

initial state preparing {
  entry { note "shepherding PR #{{ pr }}" }
  flow {
    run `git fetch origin`
    run `git rebase origin/main`
    tool scm.branches.push(repo: repo, force_with_lease: true)
  }
  on done         -> monitoring
  on failure as e -> blocked { last_error = e }
}

parallel state monitoring {
  history deep

  region ci {
    initial state waiting {
      on github.check.completed if event.conclusion == "success" -> green
      on github.check.completed if event.conclusion == "failure" -> red
    }
    state red {
      flow { agent @ci-fixer "CI failed on PR #{{ pr }} in {{ repo }}. Fix it and push." }
      on done         -> waiting
      on failure as e -> blocked { last_error = e }
    }
    final state green
  }

  region review {
    initial state awaiting {
      on github.pr.review if event.state == "approved" -> approved
      after 48h -> awaiting (reenter) {
        tool issues.comment(project: repo, number: pr, body: "Gentle ping for review 🙏")
      }
    }
    final state approved
  }

  on done -> merging
}

state merging {
  do tool scm.prs.merge(repo: repo, number: pr)
  on done                        -> merged
  on failure catch tool.conflict -> preparing (reenter)
  on failure as e                -> blocked { last_error = e }
}

state paused {
  on unhold -> monitoring.history
}

state blocked {
  on repair as r  -> preparing { attempts = attempts + 1 }
  if attempts > 3 -> abandoned
  after 24h -> blocked (reenter) {
    tool issues.comment(project: repo, number: pr, body: "Blocked: {{ last_error?.message ?? "unknown" }}")
  }
}

final state merged
final state abandoned

test "green CI + approval merges" {
  given input { repo: "acme/widget", pr: 41 }
  mock run *                   returns { exit_code: 0, stdout: "", stderr: "", duration: 1s }
  mock tool scm.branches.push  returns {}
  mock tool scm.prs.merge      returns { merged: true }
  send github.check.completed { repo: { full_name: "acme/widget" }, pr: { number: 41 }, conclusion: "success" }
  send github.pr.review       { repo: { full_name: "acme/widget" }, pr: { number: 41 }, state: "approved" }
  expect end merged
}

test "pause resumes into the same region states" {
  given input { repo: "acme/widget", pr: 42 }
  mock run *                  returns { exit_code: 0, stdout: "", stderr: "", duration: 1s }
  mock tool scm.branches.push returns {}
  send github.check.completed { repo: { full_name: "acme/widget" }, pr: { number: 42 }, conclusion: "success" }
  send hold
  expect in_state "paused"
  send unhold
  expect in_state "monitoring.ci.green"
  expect in_state "monitoring.review.awaiting"
}
