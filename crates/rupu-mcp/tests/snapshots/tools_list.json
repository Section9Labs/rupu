  {
    "description": "Record a security finding in this project's findings ledger, so it appears in the control plane rather than only in an external tracker. Use the narrowest scope the evidence supports. Under the full findings profile (the step's `findings_profile`, else the workflow default, else full) send `report` (a complete finding report) and omit summary/severity/rationale; under the summary profile send summary, severity and rationale.",
    "inputSchema": {
      "properties": {
        "code_excerpt": {
          "description": "Relevant excerpt, if any. Summary profile only.",
          "type": "string"
        },
        "concern_id": {
          "description": "Catalog concern id, when one applies.",
          "type": "string"
        },
        "file_path": {
          "description": "Workspace-relative path, for the code scopes.",
          "type": "string"
        },
        "line_range": {
          "description": "[start, end], required for scope 'line'.",
          "items": {
            "type": "integer"
          },
          "maxItems": 2,
          "minItems": 2,
          "type": "array"
        },
        "rationale": {
          "description": "Why this is a weakness, and the evidence that establishes it. Summary profile only.",
          "type": "string"
        },
        "references": {
          "description": "Supporting links — an issue URL, an advisory. Summary profile only.",
          "items": {
            "type": "string"
          },
          "type": "array"
        },
        "report": {
          "description": "A complete security finding report, recorded once by the agent. Presentations and exports (Markdown, HTML, PDF) are generated from this report, so no separate report file is written. When information genuinely cannot be determined use the field's sentinel instead of omitting it: 'Unknown', 'Not Applicable', 'None Provided', 'None', or 'Not Provided — <justification>' as each field describes.",
          "properties": {
            "artifacts": {
              "description": "Proof-of-concept files (scripts, outputs, harnesses) as workspace-relative paths; rupu stores them with the finding. Supply only 'path'.",
              "items": {
                "properties": {
                  "path": {
                    "type": "string"
                  }
                },
                "required": [
                  "path"
                ],
                "type": "object"
              },
              "type": "array"
            },
            "attack_vector": {
              "description": "How the surface is reached, including authentication or user interaction required, or 'Unknown'.",
              "type": "string"
            },
            "call_chain": {
              "anyOf": [
                {
                  "items": {
                    "properties": {
                      "binary_va": {
                        "description": "binary@VA for binary-only targets.",
                        "type": "string"
                      },
                      "file": {
                        "description": "Workspace-relative path.",
                        "type": "string"
                      },
                      "gate": {
                        "description": "Precondition crossed at this hop.",
                        "type": "string"
                      },
                      "label": {
                        "description": "Function or surface name.",
                        "type": "string"
                      },
                      "lines": {
                        "items": {
                          "type": "integer"
                        },
                        "maxItems": 2,
                        "minItems": 2,
                        "type": "array"
                      },
                      "passes_because": {
                        "description": "Why the gate passes.",
                        "type": "string"
                      },
                      "role": {
                        "enum": [
                          "source",
                          "hop",
                          "sink"
                        ],
                        "type": "string"
                      }
                    },
                    "required": [
                      "label",
                      "role"
                    ],
                    "type": "object"
                  },
                  "minItems": 1,
                  "type": "array"
                },
                {
                  "type": "string"
                }
              ],
              "description": "Ordered path from the externally reachable entry point to the sink, or 'Not Provided — <justification>'."
            },
            "category": {
              "type": "string"
            },
            "ci_cd_detection": {
              "anyOf": [
                {
                  "properties": {
                    "body": {
                      "description": "Markdown. The rule or test, verbatim.",
                      "type": "string"
                    },
                    "command": {
                      "type": "string"
                    },
                    "expect": {
                      "description": "The failing signal.",
                      "type": "string"
                    },
                    "stage": {
                      "description": "pre-merge / nightly / release gate.",
                      "type": "string"
                    }
                  },
                  "required": [
                    "stage",
                    "body",
                    "expect"
                  ],
                  "type": "object"
                },
                {
                  "type": "string"
                }
              ],
              "description": "A pipeline check that fails the build when this class of issue is present, or 'Not Provided — <justification>'."
            },
            "cross_references": {
              "anyOf": [
                {
                  "enum": [
                    "None"
                  ],
                  "type": "string"
                },
                {
                  "items": {
                    "properties": {
                      "finding_id": {
                        "type": "string"
                      },
                      "note": {
                        "type": "string"
                      },
                      "relation": {
                        "enum": [
