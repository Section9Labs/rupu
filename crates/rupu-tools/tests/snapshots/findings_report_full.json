{
  "properties": {
    "asset": {
      "description": "The engagement asset this finding is about (only under an active engagement profile). Its `kind` routes the finding to the owning profile for completeness validation and stamps it into the asset graph. Omit on a plain code run.",
      "properties": {
        "coordinates": {
          "description": "Locator coordinates pinning the asset, each {\"t\": <tag>, \"v\": <value>}. Tags: host, port, url, path, line_range, symbol, sha256, address, offset, commit, http_route, param, resource_id.",
          "items": {
            "type": "object"
          },
          "type": "array"
        },
        "kind": {
          "description": "Profile-namespaced asset kind, e.g. \"network:service\", \"binary:function\", \"web:route\".",
          "type": "string"
        },
        "label": {
          "description": "Optional human label; if omitted, the asset keeps its existing label (a new asset is labelled with its kind).",
          "type": "string"
        }
      },
      "required": [
        "kind"
      ],
      "type": "object"
    },
    "concern_id": {
      "description": "Concern ID this finding relates to, if known.",
      "type": "string"
    },
    "file_path": {
      "description": "Workspace-relative path of the affected file, if applicable.",
      "type": "string"
    },
    "line_range": {
      "description": "Line range [start, end] within the file, if applicable.",
      "items": {
        "type": "integer"
      },
      "maxItems": 2,
      "minItems": 2,
      "type": "array"
    },
    "report": {
      "description": "A complete security finding report, recorded once by the agent. Presentations and exports (Markdown, HTML, PDF) are generated from this report, so no separate report file is written. When information genuinely cannot be determined use the field's sentinel instead of omitting it: 'Unknown', 'Not Applicable', 'None Provided', 'None', or 'Not Provided — <justification>' as each field describes.",
      "properties": {
        "artifacts": {
          "description": "Proof-of-concept files (scripts, outputs, harnesses) as workspace-relative paths; rupu stores them with the finding. Supply only 'path'.",
          "items": {
            "properties": {
              "path": {
                "type": "string"
              }
            },
            "required": [
              "path"
            ],
            "type": "object"
          },
          "type": "array"
        },
        "attack_vector": {
          "description": "How the surface is reached, including authentication or user interaction required, or 'Unknown'.",
          "type": "string"
        },
        "blocks": {
          "description": "Typed evidence blocks (engagement profiles): each an object with a 'kind' tag and that kind's fields, e.g. {\"kind\":\"scan_output\",\"tool\":\"nmap\",\"output\":\"...\"} or {\"kind\":\"http_exchange\",\"request\":\"...\",\"response\":\"...\"}. Optional; additive to 'evidence'.",
          "items": {
            "properties": {
              "kind": {
                "enum": [
                  "text",
                  "code_slice",
                  "diff",
                  "table",
                  "image",
                  "hexdump",
                  "disasm",
                  "decompile",
                  "http_exchange",
                  "scan_output",
                  "pcap_ref"
                ],
                "type": "string"
              }
            },
            "required": [
              "kind"
            ],
            "type": "object"
          },
          "type": "array"
        },
        "call_chain": {
          "anyOf": [
            {
              "items": {
                "properties": {
                  "binary_va": {
                    "description": "binary@VA for binary-only targets.",
                    "type": "string"
                  },
                  "file": {
                    "description": "Workspace-relative path.",
                    "type": "string"
                  },
                  "gate": {
                    "description": "Precondition crossed at this hop.",
                    "type": "string"
                  },
                  "label": {
                    "description": "Function or surface name.",
                    "type": "string"
                  },
                  "lines": {
                    "items": {
                      "type": "integer"
                    },
                    "maxItems": 2,
                    "minItems": 2,
                    "type": "array"
                  },
                  "passes_because": {
                    "description": "Why the gate passes.",
                    "type": "string"
                  },
                  "role": {
                    "enum": [
                      "source",
                      "hop",
                      "sink"
                    ],
                    "type": "string"
                  }
                },
                "required": [
                  "label",
                  "role"
                ],
                "type": "object"
              },
              "minItems": 1,
              "type": "array"
            },
            {
              "type": "string"
            }
          ],
          "description": "Ordered path from the externally reachable entry point to the sink, or 'Not Provided — <justification>'."
        },
        "category": {
          "type": "string"
        },
        "ci_cd_detection": {
          "anyOf": [
            {
              "properties": {
                "body": {
                  "description": "Markdown. The rule or test, verbatim.",
                  "type": "string"
                },
                "command": {
                  "type": "string"
                },
                "expect": {
                  "description": "The failing signal.",
                  "type": "string"
                },
                "stage": {
                  "description": "pre-merge / nightly / release gate.",
                  "type": "string"
                }
              },
              "required": [
                "stage",
                "body",
                "expect"
              ],
              "type": "object"
            },
            {
              "type": "string"
            }
          ],
          "description": "A pipeline check that fails the build when this class of issue is present, or 'Not Provided — <justification>'."
        },
        "classifications": {
          "description": "Classifications across taxonomies (engagement profiles), e.g. {\"system\":\"CVE\",\"id\":\"CVE-2024-1234\"} or {\"system\":\"ATT&CK\",\"id\":\"T1190\"}. Optional; additive to 'cwe'.",
          "items": {
            "properties": {
              "id": {
                "type": "string"
              },
              "system": {
                "type": "string"
              },
              "vector": {
                "type": "string"
              }
            },
            "required": [
              "system",
              "id"
            ],
            "type": "object"
          },
          "type": "array"
        },
        "cross_references": {
          "anyOf": [
            {
              "enum": [
                "None"
              ],
              "type": "string"
            },
            {
              "items": {
                "properties": {
                  "finding_id": {
                    "type": "string"
                  },
                  "note": {
                    "type": "string"
                  },
                  "relation": {
                    "enum": [
                      "duplicate",
                      "sibling",
                      "prerequisite",
                      "supersedes"
                    ],
                    "type": "string"
                  }
                },
                "required": [
                  "finding_id",
                  "relation"
                ],
                "type": "object"
              },
              "minItems": 1,
              "type": "array"
            }
          ],
          "description": "'None', or related findings by the fnd_ id a previous report_finding call returned."
        },
        "cwe": {
          "description": "CWE ids, e.g. ['CWE-306']. May be empty.",
          "items": {
            "type": "string"
          },
          "type": "array"
        },
        "description": {
          "description": "Markdown. What the issue is, where it occurs, why it is a weakness.",
          "type": "string"
        },
        "evidence": {
          "description": "Minimal annotated proof, one claim per entry.",
          "items": {
            "properties": {
              "artifact": {
                "description": "Path of an entry in artifacts that proves this claim.",
                "type": "string"
              },
              "binary_va": {
                "type": "string"
              },
              "claim": {
                "type": "string"
              },
              "excerpt": {
                "description": "Only the lines that matter.",
                "type": "string"
              },
              "file": {
                "description": "Workspace-relative path.",
                "type": "string"
              },
              "lang": {
                "description": "Language for highlighting, e.g. 'c', 'sh'.",
                "type": "string"
              },
              "lines": {
                "items": {
                  "type": "integer"
                },
                "maxItems": 2,
                "minItems": 2,
                "type": "array"
              }
            },
            "required": [
              "claim"
            ],
            "type": "object"
          },
          "minItems": 1,
          "type": "array"
        },
        "impact": {
          "description": "Markdown. What an attacker could achieve and why it matters.",
          "type": "string"
        },
        "location": {
          "properties": {
            "input": {
              "description": "Markdown. Input surface, endpoint, parameter, or feature.",
              "type": "string"
            },
            "output": {
              "description": "Markdown. Affected area, response, or downstream system.",
              "type": "string"
            }
          },
          "required": [
            "input",
            "output"
          ],
          "type": "object"
        },
        "ownership": {
          "properties": {
            "affected_component": {
              "description": "Exact feature/endpoint/module, or 'Unknown'.",
              "type": "string"
            },
            "owner": {
              "description": "Accountable team/service owner, or 'Unknown'. Never invent one.",
              "type": "string"
            },
            "product": {
              "description": "Named application/platform/service, or 'Unknown'.",
              "type": "string"
            },
            "source_repository": {
              "description": "Canonical repository (optionally with a path), 'Not Applicable' when no source-controlled code is involved, or 'Unknown'.",
              "type": "string"
            }
          },
          "required": [
            "owner",
            "product",
            "affected_component",
            "source_repository"
          ],
          "type": "object"
        },
        "rating": {
          "properties": {
            "cvss_v3": {
              "description": "Base score, optionally with the vector string, or 'Unknown'. Never invent a score.",
              "type": "string"
            },
            "impact": {
              "enum": [
                "Low",
                "Medium",
                "High",
                "Critical"
              ],
              "type": "string"
            },
            "likelihood": {
              "enum": [
                "Low",
                "Medium",
                "High"
              ],
              "type": "string"
            },
            "risk_factor": {
              "enum": [
                "Low",
                "Medium",
                "High",
                "Critical"
              ],
              "type": "string"
            },
            "risk_rating": {
              "description": "Drives the finding's severity.",
              "enum": [
                "Low",
                "Medium",
                "High",
                "Critical"
              ],
              "type": "string"
            }
          },
          "required": [
            "impact",
            "likelihood",
            "risk_rating",
            "risk_factor",
            "cvss_v3"
          ],
          "type": "object"
        },
        "recommended_patch": {
          "anyOf": [
            {
              "properties": {
                "diff": {
                  "type": "string"
                },
                "notes": {
                  "description": "Markdown. Alternatives or the equivalent source-level change.",
                  "type": "string"
                }
              },
              "required": [
                "diff"
              ],
              "type": "object"
            },
            {
              "type": "string"
            }
          ],
          "description": "Minimal unified diff against the source repository (or a binary@VA pseudo-diff), or 'Not Provided — <justification>'."
        },
        "references": {
          "description": "Markdown. CWE, OWASP category, control references, related tickets.",
          "type": "string"
        },
        "regression_test": {
          "anyOf": [
            {
              "properties": {
                "body": {
                  "type": "string"
                },
                "command": {
                  "type": "string"
                },
                "expect_patched": {
                  "type": "string"
                },
                "expect_vulnerable": {
                  "type": "string"
                }
              },
              "required": [
                "body",
                "command",
                "expect_vulnerable",
                "expect_patched"
              ],
              "type": "object"
            },
            {
              "type": "string"
            }
          ],
          "description": "A deterministic test that fails on the vulnerable build and passes on the patched one, or 'Not Provided — <justification>'."
        },
        "remediation": {
          "description": "Markdown. Specific corrective actions.",
          "type": "string"
        },
        "replication_steps": {
          "description": "Sequential, reproducible steps with exact payloads and commands.",
          "items": {
            "type": "string"
          },
          "minItems": 1,
          "type": "array"
        },
        "root_cause": {
          "description": "Markdown, one or two sentences. The single underlying defect, naming the exact variable, check, or assumption that is wrong — not the symptom.",
          "type": "string"
        },
        "tickets": {
          "anyOf": [
            {
              "enum": [
                "None Provided",
                "Unknown"
              ],
              "type": "string"
            },
            {
              "items": {
                "properties": {
                  "identifier": {
                    "type": "string"
                  },
                  "notes": {
                    "type": "string"
                  },
                  "type": {
                    "description": "Jira / Bug / Remediation Tracker / Vulnerability Management / Other.",
                    "type": "string"
                  },
                  "url": {
                    "type": "string"
                  }
                },
                "required": [
                  "type",
                  "identifier"
                ],
                "type": "object"
              },
              "minItems": 1,
              "type": "array"
            }
          ],
          "description": "'None Provided' when no existing ticket is mentioned, 'Unknown' when one exists but its id is not given, or the tickets present in the evidence. Never invent a ticket."
        },
        "title": {
          "description": "Short title specific to the vulnerable feature and target.",
          "type": "string"
        }
      },
      "required": [
        "title",
        "ownership",
        "tickets",
        "rating",
        "category",
        "attack_vector",
        "cwe",
        "description",
        "impact",
        "location",
        "root_cause",
        "call_chain",
        "evidence",
        "remediation",
        "recommended_patch",
        "ci_cd_detection",
        "regression_test",
        "replication_steps",
        "cross_references",
        "references"
      ],
      "title": "rupu finding report",
      "type": "object"
    },
    "scope": {
      "description": "What the finding is about. Code scopes: 'line' (needs file_path + line_range), 'file' (needs file_path), 'repo' (the project as a whole). Target scopes, each needing target_ref: 'host' (a machine or IP), 'endpoint' (a specific service URL), 'resource' (a cloud resource by its own id). Pick the narrowest scope the evidence actually supports - claiming a whole host for a defect on one endpoint overstates it.",
      "enum": [
        "line",
        "file",
        "repo",
        "host",
        "endpoint",
        "resource"
      ],
      "type": "string"
    },
    "tags": {
      "description": "Free-form tags: lowercase a-z, 0-9 and . _ : / -, starting with a letter or digit, e.g. class:sqli, needs-poc. Reuse tags already in use where they fit (findings.query lists them).",
      "items": {
        "type": "string"
      },
      "maxItems": 32,
      "type": "array"
    },
    "target_ref": {
      "description": "What this finding is about when it is not a file: a host or IP (host), a URL (endpoint), or a cloud resource id such as an OCID/ARN/URN (resource). Required for those three scopes.",
      "type": "string"
    }
  },
  "required": [
    "scope",
    "report"
  ],
  "type": "object"
}