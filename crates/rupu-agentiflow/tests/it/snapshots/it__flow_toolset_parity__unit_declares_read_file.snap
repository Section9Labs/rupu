---
source: crates/rupu-agentiflow/tests/it/flow_toolset_parity.rs
expression: "unit_toolset(\"tools: [read_file]\\n\").await"
---
- description: "Atomically claim a work unit so no other participant duplicates it. Returns granted, or the current holder when it is already claimed."
  input_schema:
    properties:
      work_unit:
        description: "Identifier of the unit of work to claim, e.g. host:1.1.2.2"
        type: string
    required:
      - work_unit
    type: object
  name: board.claim
- description: "Post to the shared board every participant can read: an observation, a question, an answer, a vote, or a note. Optionally address it to a participant id or role."
  input_schema:
    properties:
      addressed_to:
        description: Participant id or role this post is for; omit for everyone
        type: string
      body:
        type: string
      kind:
        enum:
          - observation
          - question
          - answer
          - vote
          - note
        type: string
    required:
      - kind
      - body
    type: object
  name: board.post
- description: "Read the shared board's posts, oldest first, newest last. Returns the most recent posts (default 50); filter to those addressed to a participant id or role with addressed_to."
  input_schema:
    properties:
      addressed_to:
        description: Only posts addressed to this participant id or role
        type: string
      limit:
        description: Maximum posts to return (the most recent ones); default 50
        maximum: 500
        minimum: 1
        type: integer
    type: object
  name: board.read
- description: "Release a work unit you previously claimed with board.claim, so another participant can take it."
  input_schema:
    properties:
      work_unit:
        description: Identifier of the claimed unit of work to release
        type: string
    required:
      - work_unit
    type: object
  name: board.release
- description: "Send a message. `to` is a participant id, a role, \"parent\", or \"lead\" (delivered to exactly that inbox), or \"broadcast\" (every participant sees it once, from the moment it started listening; the broadcast log is capped per run, so don't spam it)."
  input_schema:
    properties:
      body:
        type: string
      to:
        description: "Recipient inbox: participant id, role, parent, lead or broadcast"
        type: string
    required:
      - to
      - body
    type: object
  name: msg.send
- description: "Read a file from the workspace and return its contents prefixed by 1-based line numbers separated by tabs. Always use this before editing a file so you have current line numbers. Paths are relative to the workspace root and may not leave the workspace, except into a skill's base directory (`skills.load` returns it), which may be given as an absolute path."
  input_schema:
    properties:
      path:
        description: "Path relative to the workspace root, e.g. `src/lib.rs` or `tests/foo.rs`."
        type: string
    required:
      - path
    type: object
  name: read_file
