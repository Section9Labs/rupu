/target
**/*.rs.bk
node_modules/
.DS_Store
.idea/
.vscode/
*.swp
.worktrees/
.claude/
.superpowers/
crates/rupu-coverage/build/cwe/*.xml
crates/rupu-coverage/build/cwe/*.zip
/dist

# CI mounts an in-workspace CARGO_HOME into the musl build container
# so the registry survives between runs (.github/workflows/ci.yml).
.cargo-musl/

# rupu.app (macOS, Swift) — xcodeproj is generated by xcodegen from
# apps/rupu-macos/project.yml; never commit generated project/build output.
apps/rupu-macos/*.xcodeproj
apps/rupu-macos/RupuKit/.build/
apps/rupu-macos/DerivedData/
.swiftpm/
